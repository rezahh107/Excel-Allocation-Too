"""Drag & drop allocation tree: mentors → students.

Enhancement B6: valid drop targets are highlighted in green during drag;
full/stabilised mentors are highlighted in red.
"""
from __future__ import annotations
from PySide6.QtCore import Qt, Signal
from PySide6.QtGui import QColor
from PySide6.QtWidgets import QAbstractItemView, QTreeWidget, QTreeWidgetItem

from app.core.models import AllocationResult
from app.utils.theme import ColorPalette as P

ROLE_STUDENT_IDX = Qt.ItemDataRole.UserRole + 1
ROLE_MENTOR_NAME = Qt.ItemDataRole.UserRole + 2

_PAGE_SIZE = 20


class AllocationTree(QTreeWidget):
    """Top-level items = mentors, children = students (paged).

    Emits ``moveRequested(student_idx, old_mentor, new_mentor)`` when the
    user performs a valid drop.  The *page* implementation lets the user
    click "نمایش بیشتر" to load the next 20 rows.
    """
    moveRequested = Signal(int, str, str)

    def __init__(self) -> None:
        super().__init__()
        self.setColumnCount(3)
        self.setHeaderLabels(
            ["پشتیبان / دانش‌آموز", "پشتیبان اولیه", "وضعیت"])
        self.setDragDropMode(
            QAbstractItemView.DragDropMode.InternalMove)
        self.setSelectionMode(
            QAbstractItemView.SelectionMode.SingleSelection)
        self.setDragEnabled(True)
        self.setAcceptDrops(True)
        self.setAlternatingRowColors(True)
        self._result:  AllocationResult | None = None
        self._offset:  int = _PAGE_SIZE
        self._mentor_items: dict[str, QTreeWidgetItem] = {}

    # ── public ──────────────────────────────────────────────────
    def load(self, result: AllocationResult) -> None:
        """Populate from an allocation result."""
        self._result = result
        self._offset = _PAGE_SIZE
        self.reload()

    def reload(self) -> None:
        """Rebuild the tree from the current result state."""
        if self._result is None:
            return
        self.clear()
        self._mentor_items.clear()
        shown = 0
        for m in self._result.mentors:
            load = len(self._result.assigned.get(m.name, []))
            cap  = self._result.capacity
            pct  = load / cap if cap else 0
            icon = ("🔴" if pct >= 1.0 else
                    "🟡" if pct >= 0.8 else "🟢")
            bar_len = 10
            filled  = int(pct * bar_len)
            bar     = "█" * filled + "░" * (bar_len - filled)
            top = QTreeWidgetItem([
                f"{icon}  {m.name}",
                "",
                f"[{bar}]  {load}/{cap}",
            ])
            top.setData(0, ROLE_MENTOR_NAME, m.name)
            top.setFlags(
                (top.flags() | Qt.ItemFlag.ItemIsDropEnabled)
                & ~Qt.ItemFlag.ItemIsDragEnabled)
            color = (QColor(P.ERROR)   if pct >= 1.0 else
                     QColor(P.WARNING) if pct >= 0.8 else
                     QColor(P.SUCCESS_LIGHT))
            top.setForeground(0, color)
            top.setForeground(2, color)
            self.addTopLevelItem(top)
            self._mentor_items[m.name] = top

        for name, idxs in self._result.assigned.items():
            parent = self._mentor_items.get(name)
            if parent is None:
                continue
            for idx in idxs:
                if shown >= self._offset:
                    break
                stu    = self._result.students[idx]
                stable = idx in self._result.stabilized
                child  = QTreeWidgetItem([
                    f"{stu.first} {stu.last}".strip() or stu.counter,
                    stu.initial_supporter,
                    "تثبیت‌شده 🔒" if stable else "قابل انتقال",
                ])
                child.setData(0, ROLE_STUDENT_IDX, idx)
                flags = child.flags() & ~Qt.ItemFlag.ItemIsDropEnabled
                if stable:
                    flags &= ~Qt.ItemFlag.ItemIsDragEnabled
                    child.setForeground(2, QColor(P.TEXT_MUTED))
                else:
                    flags |= Qt.ItemFlag.ItemIsDragEnabled
                    child.setForeground(2, QColor(P.SUCCESS_LIGHT))
                child.setFlags(flags)
                parent.addChild(child)
                shown += 1

        self.expandAll()

    # ── drag highlight (B6) ─────────────────────────────────────
    def dragEnterEvent(self, e):  # noqa: N802
        if e.mimeData().hasUrls():
            e.ignore()
            return
        self._highlight_targets()
        super().dragEnterEvent(e)

    def dragLeaveEvent(self, e):  # noqa: N802
        self._reset_highlights()
        super().dragLeaveEvent(e)

    def _highlight_targets(self) -> None:
        if self._result is None:
            return
        cap = self._result.capacity
        for name, top in self._mentor_items.items():
            load = len(self._result.assigned.get(name, []))
            if load < cap:
                top.setBackground(0, QColor(P.SUCCESS + "44"))
                top.setBackground(2, QColor(P.SUCCESS + "44"))
            else:
                top.setBackground(0, QColor(P.ERROR + "44"))
                top.setBackground(2, QColor(P.ERROR + "44"))

    def _reset_highlights(self) -> None:
        for top in self._mentor_items.values():
            top.setBackground(0, QColor(0, 0, 0, 0))
            top.setBackground(2, QColor(0, 0, 0, 0))

    # ── drop ────────────────────────────────────────────────────
    def dropEvent(self, e):  # noqa: N802
        self._reset_highlights()
        item = self.currentItem()
        if item is None or item.data(0, ROLE_STUDENT_IDX) is None:
            e.ignore()
            return
        target = self.itemAt(e.position().toPoint())
        if target is None:
            e.ignore()
            return
        mentor_item = target
        while (mentor_item is not None
               and mentor_item.data(0, ROLE_MENTOR_NAME) is None):
            mentor_item = mentor_item.parent()
        if mentor_item is None:
            e.ignore()
            return
        new_mentor = mentor_item.data(0, ROLE_MENTOR_NAME)
        old_parent = item.parent()
        old_mentor = (old_parent.data(0, ROLE_MENTOR_NAME)
                      if old_parent else "")
        student_idx = item.data(0, ROLE_STUDENT_IDX)
        e.ignore()   # prevent Qt from moving the item itself
        if new_mentor and new_mentor != old_mentor:
            self.moveRequested.emit(student_idx, old_mentor, new_mentor)
